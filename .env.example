# DB_PORT=5432 (Compose publishes the database on this port; keep it equal to the port in DATABASE_URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# One-time installer password (min 12 chars) that unlocks /admin. Server only.
# Required until the setup wizard is finished; may be removed afterwards.
SETUP_PASSWORD=

# Storage: local or s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_IMAGE_PIXELS=50000000
UPLOAD_MAX_VIDEO_BYTES=268435456

# Optional Google OAuth web application credentials. Configure both or leave both blank.
# Authorized redirect URI: https://your-domain.example/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only used when STORAGE_DRIVER=s3 (R2, MinIO, AWS)
# S3_ENDPOINT=
S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
